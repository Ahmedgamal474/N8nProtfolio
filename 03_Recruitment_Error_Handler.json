    {
      "parameters": {
        "jsCode": "// تحويل القيمة لرقم وحذف الفواصل إن وجدت\nconst num = (v) => Number(String(v ?? \"\").replace(/,/g, \"\"));\n\n// حساب الوقت الحالي بالدقائق (Epoch Minute)\nconst nowMin = Math.floor(Date.now() / 60000);\n\n// قراءة جميع الصفوف وتصفية الصفوف الصالحة\nconst rows = $input.all().map(i => i.json).filter(r => r.Fingerprint || r.Workflow);\n\n// تصفية الأخطاء خلال آخر 24 ساعة (1440 دقيقة)\nconst last24 = rows.filter(r => nowMin - num(r['Epoch Minute']) <= 1440);\n\n// تصفية الأخطاء المفتوحة حالياً (Status = Open)\nconst open = rows.filter(r => String(r.Status || \"\").toLowerCase() === 'open');\n\n// إحصائيات الأرقام\nconst total24h = last24.length;\nconst critical24h = last24.filter(r => String(r.Severity || \"\").toLowerCase() === 'critical').length;\nconst openCount = open.length;\nconst hasNews = total24h > 0;\n\n// 1. تجميع الأخطاء حسب النوع (Type) لآخر 24 ساعة\nconst typeCounts = {};\nfor (const r of last24) {\n  const type = r.Type || 'unknown';\n  typeCounts[type] = (typeCounts[type] || 0) + 1;\n}\n\nconst typeListHtml = Object.entries(typeCounts)\n  .map(([type, count]) => `<li><b>${type}</b>: ${count}</li>`)\n  .join('');\n\n// 2. تجميع وتكرار الأخطاء المفتوحة (Open Errors)\nconst openGrouped = {};\nfor (const r of open) {\n  // مفتاح تجميع بناءً على بيانات الخطأ الفريدة\n  const key = `${r.Workflow || ''}|${r.Node || ''}|${r.Type || ''}|${r.Severity || ''}|${r.Message || ''}|${r['Suggested Fix'] || ''}`;\n  \n  if (!openGrouped[key]) {\n    openGrouped[key] = {\n      workflow: r.Workflow || '',\n      node: r.Node || '',\n      type: r.Type || '',\n      severity: r.Severity || '',\n      message: r.Message || '',\n      suggestedFix: r['Suggested Fix'] || '',\n      count: 0\n    };\n  }\n  openGrouped[key].count += 1;\n}\n\nconst openListHtml = Object.values(openGrouped)\n  .map(item => \n    `<li><b>${item.workflow}</b> at ${item.node} (${item.type}, ${item.severity}) &times;${item.count}<br><span style=\"color:#6b7280;\">${item.message}</span><br><i>${item.suggestedFix}</i></li>`\n  )\n  .join('');\n\n// إرجاع النتيجة بالصيغة المطلوبة\nreturn [{\n  json: {\n    hasNews,\n    total24h,\n    critical24h,\n    openCount,\n    typeListHtml,\n    openListHtml\n  }\n}];"
      },
