    {
      "parameters": {
        "jsCode": "const now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm');\nconst back = {};\n\nfor (const r of $('Read Reservations').all().map(i => i.json)) {\n  if (r.res_id && r.expires_at && r.expires_at < now) {\n    back[r.sku] = (back[r.sku] || 0) + Number(r.qty);\n  }\n}\n\nconst cat = Object.fromEntries($('Read Catalog').all().map(i => [i.json.sku, i.json]));\n\nreturn Object.entries(back)\n  .filter(([s]) => cat[s])\n  .map(([sku, q]) => ({\n    json: {\n      sku,\n      stock: Number(cat[sku].stock) + q\n    }\n  }));"
      },
