    {
      "parameters": {
        "jsCode": "// 1. جلب العناصر وفلترة أي عنصر فاضي قادم من خاصية Always Output Data\nconst stuckApps = $input.all()\n  .map(item => item.json)\n  .filter(r => r && Object.keys(r).length > 0 && (r.Name || r['Applied At']));\n\nconst now = new Date();\nconst nowMs = now.getTime();\n\n// 2. حساب العدد الأجمالي وتحديد الحالة\nconst stuckCount = stuckApps.length;\nconst isStuck = stuckCount > 0;\n\nlet oldestHours = 0;\nlet listHtml = '';\n\nif (isStuck) {\n  // حساب الساعات لأقدم طلب بناءً على Applied At\n  const times = stuckApps\n    .map(r => new Date(r['Applied At']).getTime())\n    .filter(t => !isNaN(t));\n\n  if (times.length > 0) {\n    const oldestMs = Math.min(...times);\n    oldestHours = Math.floor((nowMs - oldestMs) / (1000 * 60 * 60));\n  }\n\n  // بناء قائمة الـ HTML للطلبات المعلقة\n  listHtml = stuckApps.map(r => {\n    const name = r.Name || '';\n    const position = r.Position || '';\n    const appliedAt = r['Applied At'] || '';\n    return `<li>${name} (${position}), applied ${appliedAt}</li>`;\n  }).join('');\n}\n\n// 3. تنسيق الوقت الحالي و epochMinute\nconst pad = n => String(n).padStart(2, '0');\nconst formattedTime = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())} ${pad(now.getHours())}:${pad(now.getMinutes())}`;\nconst epochMinute = Math.floor(nowMs / 60000);\n\n// 4. إرجاع النتيجة\nreturn [{\n  json: {\n    isStuck,\n    stuckCount,\n    oldestHours,\n    listHtml,\n    time: formattedTime,\n    epochMinute\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
