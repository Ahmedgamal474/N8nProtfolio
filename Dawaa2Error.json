    {
      "parameters": {
        "jsCode": "const e = $input.first().json.execution || {};\nconst wf = $input.first().json.workflow || {};\nconst msg = e.error?.message || 'Unknown error';\nconst rules = [\n  [/ETIMEDOUT|ECONNRESET|ENOTFOUND|timeout|socket hang up|aborted/i, 'network', 'warning'],\n  [/VALIDATION:/, 'validation', 'info'],\n  [/AI_OUTPUT:|JSON|Unexpected token/i, 'ai_output', 'warning'],\n  [/PUT_[A-Z_]+|chat not found|not configured/i, 'config', 'critical']\n];\nconst [, type, severity] = rules.find(([re]) => re.test(msg)) || [null, 'unknown', 'warning'];\n\nreturn [{\n  json: {\n    time: $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm'),\n    workflow: wf.name || '',\n    node: e.lastNodeExecuted || '',\n    type,\n    severity,\n    message: msg,\n    execution_url: e.url || '',\n    text: (severity === 'critical' ? '🚨' : '⚠️') + ' ' + (wf.name || 'Workflow') + ' · ' + type + '\\nNode: ' + (e.lastNodeExecuted || '?') + '\\n' + msg + '\\n' + (e.url || '')\n  }\n}];\n"
      },
